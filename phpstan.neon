includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/xefi/phpstan-xefi-rules/extension.neon

parameters:
    level: 7

    paths:
        - app
        - bootstrap/app.php
        - database
        - functional
        - routes
        - tests

    # Layer migrations live outside database/migrations, so Larastan has to be
    # told where they are before it can type the models' columns.
    databaseMigrationsPath:
        - database/migrations
        - functional/tickets/database/migrations

    excludePaths:
        analyseAndScan:
            # Published third-party migration, not project code: its up() is
            # longer than the house limit and rewriting a vendor file to
            # satisfy a lint is worse.
            - database/migrations/*_create_permission_tables.php
            # Regenerated by the faker package on every package:discover, so
            # its PHPDoc is not ours to fix; the corrected copy under phpstan/
            # is what describes faker() to the analyser.
            - faker_mixin.php

    bootstrapFiles:
        - phpstan/bootstrap.php

    # Declares every faker() extension method on Xefi\Faker\Container\Container,
    # which Xefi\Faker\Faker declares itself a @mixin of.
    stubFiles:
        - phpstan/faker-container.stub.php
